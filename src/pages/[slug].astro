---
import AdSlot from '../components/AdSlot.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ScoreSheet from '../components/ScoreSheet.tsx';
import CustomPdf from '../components/CustomPdf.tsx';
import DownloadBlock from '../components/DownloadBlock.astro';
import GameRows from '../components/GameRows.astro';
import { catalogue, categoryHref as categoryHrefs, categoryNames } from '../lib/catalogue';

export async function getStaticPaths() {
  const games = await getCollection('games', (g) => g.data.status === 'live');
  return games.map((g) => ({ params: { slug: g.data.slug }, props: { game: g.data } }));
}

type Props = { game: CollectionEntry<'games'>['data'] };
const { game } = Astro.props;
const content = game.content!;
const reference = game.scoringReference!;
const site = Astro.site!;
const url = new URL(`/${game.slug}`, site).href;
const categoryLabel = categoryNames[game.category as keyof typeof categoryNames] ?? 'Games';
const categoryHref = categoryHrefs[game.category as keyof typeof categoryHrefs] ?? '/all-games';

// Related games without a live page yet are left out until they ship.
const live = new Set((await getCollection('games', (g) => g.data.status === 'live')).map((g) => g.data.slug));
const related = game.related
  .filter((slug) => live.has(slug))
  .map((slug) => catalogue.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const preview = `/images/sheets/${game.slug}.png`;
// "Also called Yatzy or Yacht." Game names are set in italics in running text (DESIGN.md).
const aliasParts = game.aliases.length > 0 ? new Intl.ListFormat('en', { style: 'long', type: 'disjunction' }).formatToParts(game.aliases) : [];
const sheetGame = { slug: game.slug, name: game.name, players: game.players, winCondition: game.winCondition, sheet: game.sheet };

const schema = [
  {
    '@type': 'WebApplication',
    name: `${game.name} Score Sheet`,
    url,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: content.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: categoryLabel, item: new URL(categoryHref, site).href },
      { '@type': 'ListItem', position: 3, name: game.name, item: url },
    ],
  },
];
---

<Base title={game.title} description={game.description} schema={schema} image={preview}>
  <Header slot="before-main" />
  <div class="split game">
    <div class="game-top reading-block" data-reveal>
      <nav aria-label="Breadcrumb" class="t-small t-soft crumbs">
        <a href="/">Home</a>{' '}<span aria-hidden="true">›</span>{' '}<a href={categoryHref}>{categoryLabel}</a>{' '}<span aria-hidden="true">›</span>{' '}<span aria-current="page">{game.name}</span>
      </nav>
      <div class="game-title">
        <h1 class="t-head">{game.name} score sheet</h1>
        <p class="t-lead">Free printable PDF and online scorekeeper</p>
      </div>
      <p class="measure">{content.intro}</p>
      {aliasParts.length > 0 && <p class="measure aliases">Also called {aliasParts.map((p) => (p.type === 'element' ? <em>{p.value}</em> : p.value))}.</p>}
      {
        game.companions.length > 0 && (
          <ul class="rows companions">
            {game.companions.map((c) => (
              <li><a href={c.href}>{c.label}</a><span class="t-small t-soft">{c.note}</span></li>
            ))}
          </ul>
        )
      }

      <DownloadBlock slug={game.slug} alt={game.sheet.engine === 'tally' ? `Printable ${game.name} tally card with columns for wins, losses and buncos in every round` : `Printable ${game.name} score sheet with a column for each player and a row for every ${game.sheet.engine === 'category' ? 'scoring box' : game.sheet.engine === 'running-turns' ? 'turn' : game.sheet.engine === 'bid-and-make' ? 'round, with boxes for the bid, tricks won and points' : 'round'}`}>
        <CustomPdf client:idle game={sheetGame} />
      </DownloadBlock>
      <AdSlot />
    </div>

    <div class="stage game-stage print-sheet">
      <h2 class="sr-only">Online {game.name} scorekeeper</h2>
      <ScoreSheet client:idle mode="live" game={sheetGame} />
    </div>

    <div class="game-rest reading-block">
      <section aria-labelledby="ref-title" data-reveal>
        <h2 id="ref-title" class="t-head">{game.name} scoring</h2>
        <div class="table-wrap">
          <table class="ref-table">
            <thead><tr>{reference.columns.map((c) => <th scope="col">{c}</th>)}</tr></thead>
            <tbody>{reference.rows.map((r) => <tr>{r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>)}</tbody>
          </table>
        </div>
      </section>

      {
        content.howToPlay && (
          <section aria-labelledby="play-title" data-reveal>
            <h2 id="play-title" class="t-head">{content.howToPlay.heading}</h2>
            <div class="measure prose">{content.howToPlay.paragraphs.map((p) => <p>{p}</p>)}</div>
          </section>
        )
      }

      {
        content.tips && (
          <section aria-labelledby="tips-title" data-reveal>
            <h2 id="tips-title" class="t-head">Scoring tips and house rules</h2>
            <ul class="measure prose tips">{content.tips.map((t) => <li>{t}</li>)}</ul>
          </section>
        )
      }

      <section aria-labelledby="use-title" class="use" data-reveal>
        <h2 id="use-title" class="t-head">How to use this sheet</h2>
        <div class="measure prose">{content.howToUse.map((p) => <p>{p}</p>)}</div>
        {
          content.exampleRound.map((ex) => (
            <div class="slip">
              <p class="slip-time">{ex.caption}</p>
              {ex.rows.map((r) => (
                <p class="slip-row"><span>{r.label}</span><span class="slip-leader" /><span>{r.value}</span></p>
              ))}
              <p class="slip-result"><span>{ex.result}</span></p>
            </div>
          ))
        }
      </section>

      <AdSlot />

      <section aria-labelledby="faq-title" data-reveal>
        <h2 id="faq-title" class="t-head">{game.name} questions</h2>
        <div class="faq measure">{content.faqs.map((f) => <p><strong>{f.q}</strong> {f.a}</p>)}</div>
      </section>

      <section aria-labelledby="related-title" data-reveal>
        <h2 id="related-title" class="t-head">Score sheets for similar games</h2>
        <div class="related"><GameRows entries={related} /></div>
      </section>

      <AdSlot tall />
    </div>
  </div>
</Base>

