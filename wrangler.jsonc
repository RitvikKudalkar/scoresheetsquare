{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scoresheetsquare",
  "compatibility_date": "2025-09-01",
  // Static site only: dist/ is served as assets, with dist/404.html returned for unknown paths.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [{ "pattern": "scoresheetsquare.com", "custom_domain": true }],
  // workers.dev stays on as a preview; public/_headers marks it noindex.
  "workers_dev": true,
  "preview_urls": false
}
